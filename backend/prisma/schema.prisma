generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  idUsuario           BigInt       @id @default(autoincrement()) @map("id_usuario")
  nombre              String       @db.VarChar(100)
  apellido            String?      @db.VarChar(100)
  email               String       @unique @db.VarChar(150)
  telefono            String?      @db.VarChar(30)
  passwordHash        String       @map("password_hash")
  rol                 String?      @default("administrador") @db.VarChar(50)
  estado              String?      @default("activo") @db.VarChar(20)
  fechaCreacion       DateTime?    @default(now()) @map("fecha_creacion") @db.Timestamp(6)
  cotizacionesCreadas Cotizacion[]
  rotulosCreados      Rotulo[]
  cartasCreadas       Carta[]
  certificadosCreados Certificado[]
  notasCreadas        Nota[]

  @@map("usuarios")
}

model Institucion {
  idInstitucion   BigInt  @id @default(autoincrement()) @map("id_institucion")
  nombre          String  @db.VarChar(200)
  tipoInstitucion String? @map("tipo_institucion") @db.VarChar(100)
  direccion       String?
  telefono        String? @db.VarChar(30)
  email           String? @db.VarChar(150)
  estado          String? @default("activo") @db.VarChar(20)

  @@index([nombre], map: "idx_instituciones_nombre")
  @@index([estado], map: "idx_instituciones_estado")
  @@map("instituciones")
}

model Cliente {
  idCliente      BigInt       @id @default(autoincrement()) @map("id_cliente")
  nombreCompleto String       @map("nombre_completo") @db.VarChar(200)
  telefono       String?      @db.VarChar(30)
  email          String?      @unique @db.VarChar(150)
  ciudad         String?      @db.VarChar(100)
  cargo          String?      @db.VarChar(150)
  institucion    String?      @db.VarChar(150)
  direccion      String?
  observaciones  String?
  fechaCreacion  DateTime?    @default(now()) @map("fecha_creacion") @db.Timestamp(6)
  cotizaciones   Cotizacion[]
  rotulos        Rotulo[]
  cartas         Carta[]
  certificados   Certificado[]
  notas          Nota[]

  @@index([nombreCompleto], map: "idx_clientes_nombre")
  @@index([email], map: "idx_clientes_email")
  @@index([ciudad], map: "idx_clientes_ciudad")
  @@map("clientes")
}

model Carta {
  idCarta            BigInt   @id @default(autoincrement()) @map("id_carta")
  idCliente          BigInt?  @map("id_cliente")
  ciudadFecha        String   @map("ciudad_fecha") @db.VarChar(100)
  fecha              DateTime @db.Date
  numero             String?  @db.VarChar(50)
  tratamiento        String?  @db.VarChar(50)
  destinatario       String   @db.VarChar(200)
  cargoDestinatario  String?  @map("cargo_destinatario") @db.VarChar(150)
  institucion        String?  @db.VarChar(150)
  presente           String?  @db.VarChar(100)
  referencia         String   @db.VarChar(300)
  cuerpoHtml         String   @map("cuerpo_html") @db.Text
  despedida          String?  @db.VarChar(100)
  empresaFirmante    String?  @map("empresa_firmante") @db.VarChar(20)
  firmanteNombre     String?  @map("firmante_nombre") @db.VarChar(200)
  firmanteCargo      String?  @map("firmante_cargo") @db.VarChar(200)
  firmanteDocumento  String?  @map("firmante_documento") @db.VarChar(50)
  firmanteTelefono   String?  @map("firmante_telefono") @db.VarChar(30)
  papel              String   @default("letter") @db.VarChar(10)
  estado             String   @default("borrador") @db.VarChar(20)
  idUsuarioCreador   BigInt?  @map("id_usuario_creador")
  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.Timestamp(6)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.Timestamp(6)

  cliente        Cliente? @relation(fields: [idCliente], references: [idCliente], onDelete: SetNull, map: "fk_cartas_cliente")
  usuarioCreador Usuario? @relation(fields: [idUsuarioCreador], references: [idUsuario], onDelete: SetNull, map: "fk_cartas_usuario")

  @@index([idCliente], map: "idx_cartas_cliente")
  @@index([idUsuarioCreador], map: "idx_cartas_usuario")
  @@index([fechaActualizacion], map: "idx_cartas_fecha_actualizacion")
  @@index([estado], map: "idx_cartas_estado")
  @@map("cartas")
}

model Certificado {
  idCertificado       BigInt            @id @default(autoincrement()) @map("id_certificado")
  idCliente           BigInt?           @map("id_cliente")
  idNotaOrigen        BigInt?           @map("id_nota_origen")
  clienteEntidad      String             @map("cliente_entidad") @db.VarChar(250)
  objetoContratacion  String             @map("objeto_contratacion") @db.Text
  codigo              String             @db.VarChar(50)
  revision            String?            @db.VarChar(20)
  garantiaAnos        Int?               @map("garantia_anos") @db.SmallInt
  fechaDesde          DateTime?          @map("fecha_desde") @db.Date
  fechaHasta          DateTime?          @map("fecha_hasta") @db.Date
  condicionesHtml     String?            @map("condiciones_html") @db.Text
  empresaFirmante     String?            @map("empresa_firmante") @db.VarChar(20)
  firmanteNombre      String?            @map("firmante_nombre") @db.VarChar(200)
  firmanteCargo       String?            @map("firmante_cargo") @db.VarChar(200)
  firmanteDocumento   String?            @map("firmante_documento") @db.VarChar(50)
  firmanteTelefono    String?            @map("firmante_telefono") @db.VarChar(30)
  papel               String             @default("a4") @db.VarChar(10)
  estado              String             @default("borrador") @db.VarChar(20)
  idUsuarioCreador    BigInt?           @map("id_usuario_creador")
  fechaCreacion       DateTime           @default(now()) @map("fecha_creacion") @db.Timestamp(6)
  fechaActualizacion  DateTime           @default(now()) @updatedAt @map("fecha_actualizacion") @db.Timestamp(6)

  cliente        Cliente?           @relation(fields: [idCliente], references: [idCliente], onDelete: SetNull, map: "fk_certificados_cliente")
  notaOrigen     Nota?              @relation(fields: [idNotaOrigen], references: [idNota], onDelete: SetNull, map: "fk_certificados_nota_origen")
  usuarioCreador Usuario?           @relation(fields: [idUsuarioCreador], references: [idUsuario], onDelete: SetNull, map: "fk_certificados_usuario")
  items          CertificadoItem[]

  @@index([idCliente], map: "idx_certificados_cliente")
  @@index([idNotaOrigen], map: "idx_certificados_nota_origen")
  @@index([idUsuarioCreador], map: "idx_certificados_usuario")
  @@index([fechaActualizacion], map: "idx_certificados_fecha_actualizacion")
  @@index([estado], map: "idx_certificados_estado")
  @@map("certificados")
}

model CertificadoItem {
  idItem         BigInt       @id @default(autoincrement()) @map("id_item")
  idCertificado  BigInt       @map("id_certificado")
  tipoCatalogo   String       @map("tipo_catalogo") @db.VarChar(20)
  idProducto     BigInt?      @map("id_producto")
  idComponente   BigInt?      @map("id_componente")
  descripcion    String       @db.VarChar(300)
  marca          String?      @db.VarChar(150)
  modelo         String?      @db.VarChar(150)
  cantidad       Int
  aclaraciones   String?      @db.VarChar(250)
  ordenVisual    Int          @map("orden")

  certificado Certificado @relation(fields: [idCertificado], references: [idCertificado], onDelete: Cascade, map: "fk_certificado_items_certificado")
  producto    Producto?    @relation(fields: [idProducto], references: [idProducto], onDelete: SetNull, map: "fk_certificado_items_producto")
  componente  Componente?  @relation(fields: [idComponente], references: [idComponente], onDelete: SetNull, map: "fk_certificado_items_componente")

  @@index([idCertificado], map: "idx_certificado_items_certificado")
  @@index([idProducto], map: "idx_certificado_items_producto")
  @@index([idComponente], map: "idx_certificado_items_componente")
  @@map("certificado_items")
}

model Nota {
  idNota                BigInt     @id @default(autoincrement()) @map("id_nota")
  idCliente             BigInt?    @map("id_cliente")
  codigo                String?    @db.VarChar(50)
  revision              String?    @db.VarChar(20)
  numero                String?    @db.VarChar(50)
  clienteEntidad        String     @map("cliente_entidad") @db.VarChar(250)
  institucion           String?    @db.VarChar(200)
  objetoContratacion    String?    @map("objeto_contratacion") @db.Text
  lugarEntrega          String?    @map("lugar_entrega") @db.VarChar(250)
  fechaEntrega          DateTime?  @map("fecha_entrega") @db.Date
  introduccion          String?    @db.Text
  empresaEntregadoPor   String?    @map("empresa_entregado_por") @db.VarChar(20)
  entregadoNombre       String?    @map("entregado_nombre") @db.VarChar(200)
  entregadoCargo        String?    @map("entregado_cargo") @db.VarChar(200)
  entregadoDocumento    String?    @map("entregado_documento") @db.VarChar(50)
  entregadoTelefono     String?    @map("entregado_telefono") @db.VarChar(30)
  entregadoFirmaUrl     String?    @map("entregado_firma_url") @db.Text
  entregadoSelloUrl     String?    @map("entregado_sello_url") @db.Text
  ocultarSello          Boolean    @default(false) @map("ocultar_sello")
  recibidoNombre        String?    @map("recibido_nombre") @db.VarChar(200)
  recibidoCargo         String?    @map("recibido_cargo") @db.VarChar(200)
  recibidoFirmaUrl      String?    @map("recibido_firma_url") @db.Text
  papel                 String     @default("letter") @db.VarChar(10)
  estado                String     @default("borrador") @db.VarChar(20)
  idUsuarioCreador      BigInt?    @map("id_usuario_creador")
  fechaCreacion         DateTime   @default(now()) @map("fecha_creacion") @db.Timestamp(6)
  fechaActualizacion    DateTime   @default(now()) @updatedAt @map("fecha_actualizacion") @db.Timestamp(6)

  cliente        Cliente? @relation(fields: [idCliente], references: [idCliente], onDelete: SetNull, map: "fk_notas_cliente")
  usuarioCreador Usuario? @relation(fields: [idUsuarioCreador], references: [idUsuario], onDelete: SetNull, map: "fk_notas_usuario")
  items          NotaItem[]
  certificadosOrigen Certificado[]

  @@index([idCliente], map: "idx_notas_cliente")
  @@index([idUsuarioCreador], map: "idx_notas_usuario")
  @@index([fechaActualizacion], map: "idx_notas_fecha_actualizacion")
  @@index([estado], map: "idx_notas_estado")
  @@map("notas")
}

model NotaItem {
  idItem         BigInt   @id @default(autoincrement()) @map("id_item")
  idNota         BigInt   @map("id_nota")
  tipoCatalogo   String   @map("tipo_catalogo") @db.VarChar(20)
  idProducto     BigInt?  @map("id_producto")
  idComponente   BigInt?  @map("id_componente")
  nombre         String   @db.VarChar(250)
  descripcion    String?  @db.Text
  codigo         String?  @db.VarChar(100)
  numeroSerie    String?  @map("numero_serie") @db.VarChar(150)
  cantidad       Int
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(12, 2)
  ordenVisual    Int      @map("orden")

  nota       Nota       @relation(fields: [idNota], references: [idNota], onDelete: Cascade, map: "fk_nota_items_nota")
  producto   Producto?  @relation(fields: [idProducto], references: [idProducto], onDelete: SetNull, map: "fk_nota_items_producto")
  componente Componente? @relation(fields: [idComponente], references: [idComponente], onDelete: SetNull, map: "fk_nota_items_componente")

  @@index([idNota], map: "idx_nota_items_nota")
  @@index([idProducto], map: "idx_nota_items_producto")
  @@index([idComponente], map: "idx_nota_items_componente")
  @@map("nota_items")
}

model Rotulo {
  idRotulo           BigInt   @id @default(autoincrement()) @map("id_rotulo")
  idCliente          BigInt   @map("id_cliente")
  nombre             String   @db.VarChar(200)
  cargo              String?  @db.VarChar(150)
  correo             String?  @db.VarChar(150)
  telefono           String?  @db.VarChar(30)
  ciudad             String?  @db.VarChar(100)
  tamanoPapel        String   @default("letter") @map("tamano_papel") @db.VarChar(10)
  idUsuarioCreador   BigInt?  @map("id_usuario_creador")
  fechaCreacion      DateTime @default(now()) @map("fecha_creacion") @db.Timestamp(6)
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.Timestamp(6)

  cliente        Cliente  @relation(fields: [idCliente], references: [idCliente], onDelete: Restrict, map: "fk_rotulos_cliente")
  usuarioCreador Usuario? @relation(fields: [idUsuarioCreador], references: [idUsuario], onDelete: SetNull, map: "fk_rotulos_usuario")

  @@index([idCliente], map: "idx_rotulos_cliente")
  @@index([fechaCreacion], map: "idx_rotulos_fecha_creacion")
  @@map("rotulos")
}

model Categoria {
  idCategoria   BigInt         @id @default(autoincrement()) @map("id_categoria")
  nombre        String         @db.VarChar(150)
  descripcion   String?
  estado        String?        @default("activo") @db.VarChar(20)
  productos     Producto[]
  servicios     Servicio[]
  subcategorias Subcategoria[]

  @@map("categorias")
}

model Subcategoria {
  idSubcategoria BigInt     @id @default(autoincrement()) @map("id_subcategoria")
  idCategoria    BigInt     @map("id_categoria")
  nombre         String     @db.VarChar(150)
  descripcion    String?
  productos      Producto[]
  servicios      Servicio[]
  categoria      Categoria  @relation(fields: [idCategoria], references: [idCategoria], onDelete: Cascade, onUpdate: NoAction, map: "fk_subcategorias_categoria")

  @@index([idCategoria], map: "idx_subcategorias_categoria")
  @@map("subcategorias")
}

model Producto {
  idProducto     BigInt               @id @default(autoincrement()) @map("id_producto")
  idCategoria    BigInt?              @map("id_categoria")
  idSubcategoria BigInt?              @map("id_subcategoria")
  nombre         String               @db.VarChar(200)
  descripcion    String?
  precioBase     Int                  @default(0) @map("precio_base")
  cantidad       Int                  @default(1)
  sku            String?              @unique @db.VarChar(100)
  estado         String?              @default("activo") @db.VarChar(20)
  cotizaciones   CotizacionProducto[]
  componentes    ProductoComponente[]
  certificadoItems CertificadoItem[]
  notaItems       NotaItem[]
  imagenes       ProductoImagen[]
  categoria      Categoria?           @relation(fields: [idCategoria], references: [idCategoria], onUpdate: NoAction, map: "fk_productos_categoria")
  subcategoria   Subcategoria?        @relation(fields: [idSubcategoria], references: [idSubcategoria], onUpdate: NoAction, map: "fk_productos_subcategoria")

  @@index([idCategoria], map: "idx_productos_categoria")
  @@index([idSubcategoria], map: "idx_productos_subcategoria")
  @@index([nombre], map: "idx_productos_nombre")
  @@map("productos")
}

model ProductoImagen {
  idImagen   BigInt @id @default(autoincrement()) @map("id_imagen")
  idProducto BigInt @map("id_producto")

  // File info
  urlImagen  String  @map("url_imagen")
  rutaBucket String? @map("ruta_bucket")

  // Metadata
  orden     Int?     @default(1)
  principal Boolean? @default(false)

  // Control
  estado        String?   @default("activo") @db.VarChar(20)
  fechaCreacion DateTime? @default(now()) @map("fecha_creacion") @db.Timestamp(6)

  producto Producto @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade, onUpdate: NoAction, map: "fk_producto_imagenes_producto")

  @@index([idProducto], map: "idx_producto_imagenes_producto")
  @@index([principal], map: "idx_producto_imagenes_principal")
  @@map("producto_imagenes")
}

model ComponenteImagen {
  idImagen     BigInt @id @default(autoincrement()) @map("id_imagen")
  idComponente BigInt @map("id_componente")

  // File info
  urlImagen String @map("url_imagen")

  // Metadata
  orden     Int?     @default(1)
  principal Boolean? @default(false)

  // Control
  estado        String?   @default("activo") @db.VarChar(20)
  fechaCreacion DateTime? @default(now()) @map("fecha_creacion") @db.Timestamp(6)

  componente Componente @relation(fields: [idComponente], references: [idComponente], onDelete: Cascade, onUpdate: NoAction, map: "fk_componente_imagenes_componente")

  @@index([idComponente], map: "idx_componente_imagenes_componente")
  @@index([principal], map: "idx_componente_imagenes_principal")
  @@map("componente_imagenes")
}

model Componente {
  idComponente BigInt                 @id @default(autoincrement()) @map("id_componente")
  nombre       String                 @db.VarChar(200)
  descripcion  String?
  precioBase   Int                    @default(0) @map("precio_base")
  sku          String?                @unique @db.VarChar(100)
  estado       String?                @default("activo") @db.VarChar(20)
  cotizaciones CotizacionComponente[]
  productos    ProductoComponente[]
  imagenes     ComponenteImagen[]
  certificadoItems CertificadoItem[]
  notaItems       NotaItem[]

  @@index([sku], map: "idx_componentes_sku")
  @@index([estado], map: "idx_componentes_estado")
  @@map("componentes")
}

model ProductoComponente {
  idProductoComponente BigInt     @id @default(autoincrement()) @map("id_producto_componente")
  idProducto           BigInt     @map("id_producto")
  idComponente         BigInt     @map("id_componente")
  cantidad             Int        @default(1)
  precioReferencial    Int?       @default(0) @map("precio_referencial")
  observaciones        String?
  componente           Componente @relation(fields: [idComponente], references: [idComponente], onUpdate: NoAction, map: "fk_producto_componentes_componente")
  producto             Producto   @relation(fields: [idProducto], references: [idProducto], onDelete: Cascade, onUpdate: NoAction, map: "fk_producto_componentes_producto")

  @@index([idProducto], map: "idx_producto_componentes_producto")
  @@index([idComponente], map: "idx_producto_componentes_componente")
  @@map("producto_componentes")
}

model Servicio {
  idServicio     BigInt               @id @default(autoincrement()) @map("id_servicio")
  idCategoria    BigInt?              @map("id_categoria")
  idSubcategoria BigInt?              @map("id_subcategoria")
  nombre         String               @db.VarChar(200)
  descripcion    String?
  precioBase     Int                  @default(0) @map("precio_base")
  estado         String?              @default("activo") @db.VarChar(20)
  cotizaciones   CotizacionServicio[]
  imagenes       ServicioImagen[]
  categoria      Categoria?           @relation(fields: [idCategoria], references: [idCategoria], onUpdate: NoAction, map: "fk_servicios_categoria")
  subcategoria   Subcategoria?        @relation(fields: [idSubcategoria], references: [idSubcategoria], onUpdate: NoAction, map: "fk_servicios_subcategoria")

  @@index([idCategoria], map: "idx_servicios_categoria")
  @@index([idSubcategoria], map: "idx_servicios_subcategoria")
  @@index([nombre], map: "idx_servicios_nombre")
  @@index([estado], map: "idx_servicios_estado")
  @@map("servicios")
}

model ServicioImagen {
  idImagen      BigInt    @id @default(autoincrement()) @map("id_imagen")
  idServicio    BigInt    @map("id_servicio")
  urlImagen     String    @map("url_imagen")
  orden         Int?      @default(1)
  principal     Boolean?  @default(false)
  fechaCreacion DateTime? @default(now()) @map("fecha_creacion") @db.Timestamp(6)
  servicio      Servicio  @relation(fields: [idServicio], references: [idServicio], onDelete: Cascade, onUpdate: NoAction, map: "fk_servicio_imagenes_servicio")

  @@index([idServicio], map: "idx_servicio_imagenes_servicio")
  @@map("servicio_imagenes")
}

model Cotizacion {
  idCotizacion        BigInt                 @id @default(autoincrement()) @map("id_cotizacion")
  numeroCotizacion    String                 @unique @map("numero_cotizacion") @db.VarChar(50)
  idCliente           BigInt                 @map("id_cliente")
  fechaEmision        DateTime               @default(dbgenerated("CURRENT_DATE")) @map("fecha_emision") @db.Date
  fechaValidez        DateTime?              @default(dbgenerated("CURRENT_DATE + INTERVAL '10 days'")) @map("fecha_validez") @db.Date
  diasEntrega         Int?                   @default(5) @map("dias_entrega")
  estado              String?                @default("borrador") @db.VarChar(50)
  subtotal            Int?                   @default(0)
  descuento           Int?                   @default(0)
  impuestos           Int?                   @default(0)
  total               Int?                   @default(0)
  moneda              String?                @default("Bs") @db.VarChar(10)
  observaciones       String?
  terminosCondiciones String?                @map("terminos_condiciones")
  idUsuarioCreador    BigInt?                @map("id_usuario_creador")
  fechaCreacion       DateTime?              @default(now()) @map("fecha_creacion")
  componentes         CotizacionComponente[]
  productos           CotizacionProducto[]
  servicios           CotizacionServicio[]
  imagenes            CotizacionImagen[]
  cliente             Cliente                @relation(fields: [idCliente], references: [idCliente], onUpdate: NoAction, map: "fk_cotizaciones_cliente")
  usuarioCreador      Usuario?               @relation(fields: [idUsuarioCreador], references: [idUsuario], onUpdate: NoAction, map: "fk_cotizaciones_usuario")

  @@index([idCliente], map: "idx_cotizaciones_cliente")
  @@index([idUsuarioCreador], map: "idx_cotizaciones_usuario")
  @@index([fechaEmision], map: "idx_cotizaciones_fecha")
  @@index([estado], map: "idx_cotizaciones_estado")
  @@map("cotizaciones")
}

model CotizacionProducto {
  idDetalleProducto BigInt     @id @default(autoincrement()) @map("id_detalle_producto")
  idCotizacion      BigInt     @map("id_cotizacion")
  idProducto        BigInt     @map("id_producto")
  nombreItem        String     @map("nombre_item") @db.VarChar(200)
  descripcionItem   String?    @map("descripcion_item")
  cantidad          Int        @default(1)
  precioUnitario    Int        @default(0) @map("precio_unitario")
  descuento         Int?       @default(0)
  subtotal          Int?       @default(0)
  ordenVisual       Int?       @default(1) @map("orden_visual")
  observaciones     String?
  cotizacion        Cotizacion @relation(fields: [idCotizacion], references: [idCotizacion], onDelete: Cascade, onUpdate: NoAction, map: "fk_cotizacion_productos_cotizacion")
  producto          Producto   @relation(fields: [idProducto], references: [idProducto], onUpdate: NoAction, map: "fk_cotizacion_productos_producto")

  @@index([idCotizacion], map: "idx_cotizacion_productos_cotizacion")
  @@index([idProducto], map: "idx_cotizacion_productos_producto")
  @@map("cotizacion_productos")
}

